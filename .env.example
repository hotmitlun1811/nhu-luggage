# Gmail SMTP — powers the automated "policy & agreement" email sent from the
# booking forms. Copy this file to .env.local for local dev, and add the same
# keys to the Vercel project's Environment Variables for production.

# The Gmail account that authenticates and actually sends the mail. Must have
# 2-Step Verification on, with an App Password generated for "Mail" at
# https://myaccount.google.com/apppasswords — a normal account password will
# not work. Gmail's relay requires the "from" address to match this account,
# so this is also who the customer sees as the sender.
GMAIL_USER=

# The 16-character App Password (spaces optional, either form works).
GMAIL_APP_PASSWORD=

# Where customer replies should land — doesn't have to match GMAIL_USER.
EMAIL_REPLY_TO=stowdanang@gmail.com

# Public site URL, used to build absolute links (Terms/Privacy) inside the email.
NEXT_PUBLIC_SITE_URL=https://stow-vn.vercel.app

# Lark integration — pushes every booking (from BookingForm and IntakeForm) into
# a Lark Base table and announces it in a Lark group chat. Powers
# src/app/api/lark/booking/route.ts. Custom app created at
# open.larksuite.com (Developer Console); the bot identity needs the
# base:app:create, bitable, and im:message scopes approved there.

# App ID / Secret of the Lark custom app (bot identity — server-to-server,
# never exposed to the browser).
LARK_APP_ID=
LARK_APP_SECRET=

# The Base's app_token and the target table's ID, both visible in the Base
# URL: https://<domain>.larksuite.com/base/<app_token>?table=<table_id>
LARK_BASE_APP_TOKEN=
LARK_BASE_TABLE_ID=

# Group chat ID (oc_...) the bot announces new bookings into. Optional —
# without it, bookings still write to Base, just skip the announcement.
LARK_CHAT_ID=
